# Example .env file
# You should replace these values and rename this file .env
MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_USER=tatou
MARIADB_PASSWORD=tatou
FLAG_2=my_flag2

# Signing key for authentication tokens. REQUIRED — the server refuses to start
# without it. Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Watermarking and RMAP configuration (replace placeholders locally)
WM_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
RMAP_KEY_PASSPHRASE=replace-with-your-private-key-passphrase
RMAP_WM_METHOD=rmc
